# Public web server: HTTPS (Let's Encrypt, automatic), the Angular site and the API under /api.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Scripts only from this site (plus inline speculation rules: data, not code, see index.html); styles
		# inline (Angular and PrimeNG inject them); map tiles from OpenStreetMap.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'inline-speculation-rules' https://www.googletagmanager.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org https://*.google-analytics.com https://*.googletagmanager.com https://www.google.com https://*.g.doubleclick.net; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.g.doubleclick.net; frame-src https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# The main language (SITE_LANGUAGE, English by default) is the root: with English main,
	# /en/tariffs → /tariffs (people and links often add the code).
	redir /{$SITE_LANGUAGE:en} / 301
	handle_path /{$SITE_LANGUAGE:en}/* {
		redir * {path} 301
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		# Hashed bundles never change; images and fonts change rarely; pages must always be fresh.
		@hashed path_regexp \.[0-9A-Z]{8}\.(js|css)$|-[0-9A-Z]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@assets path /assets/* /favicon.ico
		header @assets Cache-Control "public, max-age=604800"
		header ?Cache-Control "no-cache"

		# One build per language: the main language at the root, the others under /it, /en, /de, /fr
		# (the main language's prefix never gets here: it redirects to the root above).
		# Public pages are prerendered (/de/tariffs → de/tariffs/index.html). Anything else (panel,
		# personal links, unknown addresses) gets that language's browser-rendered page, never indexed.
		@it path /it /it/*
		@en path /en /en/*
		@de path /de /de/*
		@fr path /fr /fr/*
		route @it {
			try_files {path} {path}/index.html /it/index.csr.html
		}
		route @en {
			try_files {path} {path}/index.html /en/index.csr.html
		}
		route @de {
			try_files {path} {path}/index.html /de/index.csr.html
		}
		route @fr {
			try_files {path} {path}/index.html /fr/index.csr.html
		}
		route {
			try_files {path} {path}/index.html /index.csr.html
			@client path */index.csr.html /index.csr.html
			header @client X-Robots-Tag "noindex, nofollow"
			file_server
		}
	}

	log {
		output stdout
		format json
	}
}

# www.domain → domain (its own certificate, so both addresses work over HTTPS).
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} 308
}
