# Copy to .env (never commit it). Generate keys with: openssl rand -base64 48
SITE_DOMAIN=magnusdrive.it
ACME_EMAIL=tech@magnusdrive.it

POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
LINKS_SIGNING_KEY=

# First admin, created only when the database has no staff. Remove both after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Stripe live keys (Dashboard → Developers). Webhook: https://SITE_DOMAIN/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Any SMTP provider (Brevo, Postmark, Amazon SES…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=bookings@magnusdrive.it

# "Meta" once the WhatsApp Business account and templates are approved; "Log" until then.
WHATSAPP_PROVIDER=Log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# The public OSRM/Nominatim servers are not for production traffic: use a provider or self-host.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Printed on invoices.
COMPANY_NAME=Magnus Drive
COMPANY_ADDRESS=
COMPANY_VAT_NUMBER=
COMPANY_TAX_CODE=
COMPANY_EMAIL=
COMPANY_PHONE=

# Daily database dump (server time) kept this many days, in this host folder. Copy it off the server too.
BACKUP_AT=03:15
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=./backups
