# Copy to .env (never commit it). Generate keys with: openssl rand -base64 48
# One server per client: the brand (a folder in frontend/src/brands/) and this client's domain.
BRAND=magnus-drive
SITE_DOMAIN=magnusdrive.it
# The language at the root of the site (it, en, de or fr); the others are under /it, /en, /de, /fr.
SITE_LANGUAGE=en
# Where trips are served: "europe" (EU, EEA, UK, Switzerland, Balkans) or ISO codes, e.g. it,fr,ch,de.
SERVICE_AREA=europe
# The company's own time zone: "today" in the panel, shift days, monthly reports and invoices.
# Ride times always use the local time where the ride starts.
TIME_ZONE=Europe/Rome
ACME_EMAIL=tech@magnusdrive.it

POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
LINKS_SIGNING_KEY=

# First admin, created only when the database has no staff. Remove both after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Stripe live keys (Dashboard → Developers). Webhook: https://SITE_DOMAIN/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Any SMTP provider (Brevo, Postmark, Amazon SES…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=bookings@magnusdrive.it

# "Meta" once the WhatsApp Business account and templates are approved; "Log" until then.
WHATSAPP_PROVIDER=Log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Booking.com Taxi Supplier API, PRODUCTION credentials (from the Booking.com supplier email).
# "true" starts fetching rides every minute. AUTO_ACCEPT=false: rides are accepted when assigned.
BOOKINGCOM_ENABLED=false
BOOKINGCOM_CLIENT_ID=
BOOKINGCOM_CLIENT_SECRET=
BOOKINGCOM_AUTO_ACCEPT=true

# The public OSRM/Nominatim servers are not for production traffic: use a provider or self-host.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Printed on invoices; also the sender name of emails.
COMPANY_NAME=Magnus Drive
# Letters before booking references (MD-7K3QX9) and invoice numbers (MD-2026-000001): 2–4 letters.
BOOKING_PREFIX=MD
INVOICE_PREFIX=MD
COMPANY_ADDRESS=
COMPANY_VAT_NUMBER=
COMPANY_TAX_CODE=
COMPANY_EMAIL=
COMPANY_PHONE=

# Daily database dump (server time) kept this many days, in this host folder. Copy it off the server too.
BACKUP_AT=03:15
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=./backups
