{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "start:languages": "ng build --configuration development --localize --watch & node scripts/serve-languages.mjs",
    "start:stage": "ng serve --configuration staging",
    "start:prod": "ng serve --configuration production",
    "start:local": "ng serve --configuration local",
    "generate-fonts": "npm run icons:outline && fantasticon && node scripts/inline-icon-font.mjs && prettier --write src/app/core/models/icon-names.generated.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint --fix",
    "prettier": "npx prettier --write .",
    "test:unit": "ng test",
    "test:ui": "ng test --ui",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --code-coverage",
    "icons:outline": "oslllo-svg-fixer -s src/assets/icons/src -d src/assets/icons/font-icons",
    "images": "node scripts/images.mjs",
    "build:site": "ng build --define \"SITE_URL='${SITE_URL}'\" && node scripts/seo-files.mjs",
    "i18n": "ng extract-i18n --format json --output-path src/locale && node scripts/i18n-check.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@abacritt/angularx-social-login": "2.5.1",
    "@angular/animations": "^21.1.1",
    "@angular/cdk": "^21.1.1",
    "@angular/common": "^21.1.1",
    "@angular/compiler": "^21.1.1",
    "@angular/core": "^21.1.1",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^21.1.1",
    "@angular/material": "^21.1.1",
    "@angular/material-moment-adapter": "^21.1.1",
    "@angular/platform-browser": "^21.1.1",
    "@angular/platform-browser-dynamic": "^21.1.1",
    "@angular/platform-server": "^21.1.1",
    "@angular/router": "^21.1.1",
    "@angular/service-worker": "^21.1.1",
    "@angular/ssr": "^21.2.27",
    "@iplab/ngx-file-upload": "^21.0.0",
    "@ngneat/helipopper": "^12.2.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@primeuix/themes": "^2.0.3",
    "@sumsub/websdk": "^2.3.8",
    "angular-svg-icon": "^18.0.2",
    "angularx-qrcode": "^21.0.4",
    "filesize": "^10.1.6",
    "flowbite": "^2.5.2",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "ng-otp-input": "^2.0.10",
    "ngx-mask": "^18.0.1",
    "ngx-moment": "^6.0.2",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.4",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.1.0",
    "@angular-eslint/eslint-plugin": "21.1.0",
    "@angular-eslint/eslint-plugin-template": "21.1.0",
    "@angular-eslint/schematics": "21.1.0",
    "@angular-eslint/template-parser": "21.1.0",
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.1",
    "@angular/localize": "^21.2.25",
    "@types/jasmine": "~5.1.4",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.13",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fantasticon": "^3.0.0",
    "jasmine-core": "~5.4.0",
    "jsdom": "^29.1.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "oslllo-svg-fixer": "^6.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.3.0",
    "relative-deps": "^1.0.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@angular/fire": {
      "@angular/common": "^21.1.1",
      "@angular/compiler": "^21.1.1",
      "@angular/cdk": "^21.1.1",
      "@angular/core@": "^21.0.8",
      "@angular/platform-browser": "^21.1.1",
      "@angular/platform-browser-dynamic": "^21.1.1"
    },
    "angular-google-tag-manager": {
      "@angular/common": "^21.1.1",
      "@angular/compiler": "^21.1.1"
    }
  }
}
