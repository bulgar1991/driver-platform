{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush",
          "standalone": true,
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js", "@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": ["images/src/**", "icons/**"]
              },
              "src/exit_iframe.html",
              "src/manifest.webmanifest",
              "src/robots.txt"
            ],
            "styles": [
              "node_modules/primeicons/primeicons.css",
              "node_modules/leaflet/dist/leaflet.css",
              "src/styles.scss",
              "src/assets/fonts/icons.css"
            ],
            "preserveSymlinks": true,
            "scripts": [
              "src/polyfills/structured-clone.js",
              "src/polyfills/hasOwn.js",
              "src/polyfills/arrayAt.js"
            ],
            "allowedCommonJsDependencies": ["leaflet"],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "localize": true,
            "i18nMissingTranslation": "error"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "40kb"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["it"]
            },
            "development-en": {
              "localize": ["en"],
              "baseHref": "/en/"
            },
            "development-de": {
              "localize": ["de"],
              "baseHref": "/de/"
            },
            "development-fr": {
              "localize": ["fr"],
              "baseHref": "/fr/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production",
              "proxyConfig": "proxy.prod.json"
            },
            "development": {
              "buildTarget": "frontend:build:development",
              "proxyConfig": "proxy.dev.json"
            },
            "staging": {
              "buildTarget": "frontend:build:development",
              "proxyConfig": "proxy.stage.json"
            },
            "local": {
              "buildTarget": "frontend:build:development",
              "proxyConfig": "proxy.local.json"
            },
            "development-en": {
              "buildTarget": "frontend:build:development,development-en",
              "proxyConfig": "proxy.dev.json",
              "servePath": "/en/"
            },
            "development-de": {
              "buildTarget": "frontend:build:development,development-de",
              "proxyConfig": "proxy.dev.json",
              "servePath": "/de/"
            },
            "development-fr": {
              "buildTarget": "frontend:build:development,development-fr",
              "proxyConfig": "proxy.dev.json",
              "servePath": "/fr/"
            }
          },
          "options": {
            "host": "0.0.0.0"
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "frontend:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "frontend:build:development",
            "runner": "vitest",
            "runnerConfig": true,
            "providersFile": "src/test-setup.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "en",
          "subPath": "en"
        },
        "locales": {
          "it": {
            "translation": "src/locale/messages.it.json",
            "subPath": ""
          },
          "de": {
            "translation": "src/locale/messages.de.json",
            "subPath": "de"
          },
          "fr": {
            "translation": "src/locale/messages.fr.json",
            "subPath": "fr"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": ["@angular-eslint/schematics"],
    "cache": {
      "enabled": false
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
